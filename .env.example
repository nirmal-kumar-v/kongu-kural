# Kongu Kural Environment Configuration Template
PORT=5000

# Gemini API Keys (Configure up to 3 keys for automatic failover/rotation)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# Groq API Keys (Configure up to 3 keys for automatic failover/rotation)
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Settings
NODE_ENV=development
