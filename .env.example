# Kongu Kural Environment Configuration Template
# For local development: copy this to .env and fill in your keys
# For Vercel deployment: configure these environment variables in your Vercel Project Settings

PORT=5000

# ===================================================================
# Primary AI Provider — Google Gemini (Required for chat)
# ===================================================================
# In Vercel, set GEMINI_API_KEY (or GEMINI_API_KEY_1)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini Failover Keys (for automatic multi-key quota failover)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# ===================================================================
# Fallback AI Provider — Groq (Required for failover & semantic analysis)
# ===================================================================
# In Vercel, set GROQ_API_KEY (or GROQ_API_KEY_1)
GROQ_API_KEY=your_groq_api_key_here

# Optional Groq Failover Keys (for automatic multi-key quota failover)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# ===================================================================
# Optional Server Settings
# ===================================================================
NODE_ENV=production
